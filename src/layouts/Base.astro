---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { product, company, siteTarget } from "../site.config.mjs";

const isOperon = siteTarget === "operon";
const defaultTitle = isOperon ? company.heading.main : product.title;
const defaultDescription = isOperon ? company.tagline : product.description;
const {
  title = defaultTitle,
  description = defaultDescription,
  showHeader = true,
} = Astro.props;
---
<!doctype html>
<html lang="en" data-theme={isOperon ? "dark" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content={isOperon ? "#0E0F12" : "#F4F5F7"} />
    <link rel="icon" href={product.icon} type={product.icon.endsWith(".svg") ? "image/svg+xml" : "image/png"} />
  </head>
  <body>
    {showHeader && <Header />}
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
